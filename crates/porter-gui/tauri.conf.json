{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Porter",
  "identifier": "io.github.mareksuchanek.porter",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Porter",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Browse and manage local and remote file systems",
    "longDescription": "Porter browses, searches and transfers files on local disks and remote storage (SFTP, S3, FTP, SMB, NFS) from one window or the command line.",
    "homepage": "https://github.com/MarekSuchanek/porter",
    "publisher": "Marek Suchánek",
    "copyright": "© 2026 Marek Suchánek",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "section": "utils" },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQzk3RUEzMTM1NzU2OTMKUldTVFZsY1RvMzdKYlFZOCtLTnVDakZUUys2UFc3Yzl3VjlhRU8yYWtTNzhNbFAvNjR3ZmtMYnQK",
      "endpoints": [
        "https://github.com/MarekSuchanek/porter/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
